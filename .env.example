# Copy this file to .env and replace every placeholder with local-only values.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# PostgreSQL database used by Django.
POSTGRES_DB=aniworld
POSTGRES_USER=aniworld_app
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
